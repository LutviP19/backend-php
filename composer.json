{
    "name": "lutvip19/backend-php",
    "license": "MIT",
    "description": "Simple PHP framework for backend services.",
    "keywords": ["mvc", "framework", "openswoole", "php-ffi", "asynchronous", "microservice", "event-driven", "task-scheduler", "websocket"],
    "require": {
        "php": "^8.3",
        "openswoole/core": "^22.2",
        "nikic/fast-route": "^1.3",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "predis/predis": "^3.5.1",
        "monolog/monolog": "^3.9",
        "symfony/console": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "symfony/messenger": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/validator": "^7.4",
        "php-amqplib/php-amqplib": "^3.7",
        "amphp/amp": "^3.1",
        "amphp/http-client": "^5.3",
        "revolt/event-loop": "^1.0",
        "roolith/event": "^1.0",
        "nesbot/carbon": "^3.11",
        "neuron-core/neuron-ai": "^2.11",
        "phpstreamserver/scheduler": "^0.8.0",

        "rbdwllr/reallysimplejwt": "^5.0"
    },
    "bin": [
        "bin/console"
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/inject_php.php"
        ]
    },
    "require-dev": {
        "inspector-apm/inspector-php": "^3.16",
        "pestphp/pest": "^3.8",
        "fakerphp/faker": "^1.24",
        "rector/rector": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
