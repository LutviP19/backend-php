#!/usr/bin/env php
<?php 

/**
 * @author LutviP19 <lutvip19@gmail.com>
 * Generator Tool - Backend PHP
 * Usage: ./generator [Name] [Destination Folder]
 * Examples:
 *   ./generator DashboardModel
 *   ./generator AdminSettingsModel App/Models/Admin
 *   ./generator AdminSettingsController app/Controllers/Admin
 *   ./generator UserApiController App/Controllers/Api
 *   ./generator detail_pesanan views/order
 */

declare(strict_types=1);

include_once './stubs/Stubs.php';

// Standardize Autoload / Stubs Class Loading
$stubsPath = __DIR__ . '/stubs/Stubs.php';
if (file_exists($stubsPath)) {
    require_once $stubsPath;
} elseif (file_exists(__DIR__ . '/app/Core/Support/Stubs.php')) {
    require_once __DIR__ . '/app/Core/Support/Stubs.php';
} else {
    fwrite(STDERR, "\033[0;31m❌ Error: Stubs class file not found.\033[0m" . PHP_EOL);
    exit(1);
}


// 1. Capture Input & Interactive Fallback
$inputName   = $argv[1] ?? null;
$folderInput = $argv[2] ?? null;

if (!$inputName) {
    fwrite(STDOUT, "\033[0;33m❓ Nama file/class tidak ditentukan. Masukkan nama: \033[0m");
    $handle = fopen("php://stdin", "r");
    $inputName = trim((string) fgets($handle));
    fclose($handle);

    if (empty($inputName)) {
        fwrite(STDOUT, "\033[0;31m❌ Proses dibatalkan.\033[0m" . PHP_EOL);
        exit(1);
    }
}

// 2. Determine File Type & Process Stub Generation
$lowerInput = strtolower($inputName);

// --- A. MODEL GENERATOR ---
if (str_contains($lowerInput, 'model')) {
    $stubPath  = './stubs/Models/sample.php';
    $targetDir = $folderInput ?: 'app/Models';
    
    $newClassName = Stubs::formatClassName($inputName, 'Model');
    echo Stubs::generate($newClassName, $stubPath, $targetDir);
}

// --- B. CONTROLLER GENERATOR (Web & API) ---
elseif (str_contains($lowerInput, 'controller')) {
    // API Controller Specifics
    if (str_contains($lowerInput, 'api')) {
        $stubPath  = './stubs/Controllers/sample-api.php';
        $targetDir = $folderInput ?: 'app/Controllers/Api';
        $newClassName = Stubs::formatClassName($inputName, 'ApiController');
    } else {
        // Standard Web Controller
        $stubPath  = './stubs/Controllers/sample.php';
        $targetDir = $folderInput ?: 'app/Controllers';
        $newClassName = Stubs::formatClassName($inputName, 'Controller');
    }

    echo Stubs::generate($newClassName, $stubPath, $targetDir);
}

// --- C. VIEW GENERATOR ---
else {
    $stubPath  = './stubs/Views/sample.php';
    $targetDir = $folderInput ?: 'views';

    $viewName = Stubs::formatViewName($inputName);
    echo Stubs::generateView($viewName, $stubPath, $targetDir);
}

exit(0);